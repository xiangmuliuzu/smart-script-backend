######################################################################
# Build Tools

.gradle
/build/
!gradle/wrapper/gradle-wrapper.jar

target/
!.mvn/wrapper/maven-wrapper.jar

######################################################################
# IDE

### STS ###
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans

### IntelliJ IDEA ###
.idea
*.iws
*.iml
*.ipr

### JRebel ###
rebel.xml

### NetBeans ###
nbproject/private/
build/*
nbbuild/
dist/
nbdist/
.nb-gradle/

######################################################################
# Others
# 本地凭据加载与启动脚本，含数据库/密钥注入逻辑，禁止入库
/.local/
*.log
*.xml.versionsBackup
*.swp

# 本地私有环境变量（见 .env.example 与 README「环境变量」）
# 必须忽略：其中会放 TOKEN_SECRET / APP_TOKEN_SECRET 等本机密钥
.env.local
.env.*.local

!*/build/*.java
!*/build/*.html
!*/build/*.xml

######################################################################
# 运行时产物与解包残留（仅本地，已入库的种子素材/历史文件不受影响）
# 用根级锚定，避免误伤 */src/main/java/com/ 源码包
/BOOT-INF/
/com/
# 上传/签署运行期输出不再入仓（历史 144 个已跟踪文件仍随克隆保留）
/uploadPath/
