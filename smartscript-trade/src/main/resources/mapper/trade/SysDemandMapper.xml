<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smartscript.platform.trade.mapper.SysDemandMapper">

    <resultMap type="com.smartscript.platform.trade.domain.SysDemand" id="SysDemandResult">
        <result property="demandId"        column="demand_id" />
        <result property="demandNo"        column="demand_no" />
        <result property="clientId"        column="client_id" />
        <result property="title"           column="title" />
        <result property="genreId"         column="genre_id" />
        <result property="budget"          column="budget" />
        <result property="deadline"        column="deadline" />
        <result property="requirement"     column="requirement" />
        <result property="contactInfo"     column="contact_info" />
        <result property="submissionCount" column="submission_count" />
        <result property="status"          column="status" />
        <result property="createdAt"       column="created_at" />
        <result property="updatedAt"       column="updated_at" />
        <result property="createBy"        column="create_by" />
        <result property="createTime"      column="create_time" />
        <result property="updateBy"        column="update_by" />
        <result property="updateTime"      column="update_time" />
        <result property="remark"          column="remark" />
    </resultMap>

    <select id="selectDemandList" parameterType="com.smartscript.platform.trade.domain.SysDemand" resultMap="SysDemandResult">
        select demand_id, demand_no, client_id, title, genre_id, budget, deadline,
               requirement, contact_info, submission_count, status,
               created_at, updated_at, create_by, create_time, update_by, update_time, remark
        from sys_demand
        <where>
            <if test="title != null and title != ''">AND title like concat('%', #{title}, '%')</if>
            <if test="status != null and status != ''">AND status = #{status}</if>
            <if test="demandNo != null and demandNo != ''">AND demand_no like concat('%', #{demandNo}, '%')</if>
        </where>
        order by created_at desc
    </select>

    <select id="selectDemandById" parameterType="Long" resultMap="SysDemandResult">
        select demand_id, demand_no, client_id, title, genre_id, budget, deadline,
               requirement, contact_info, submission_count, status,
               created_at, updated_at, create_by, create_time, update_by, update_time, remark
        from sys_demand
        where demand_id = #{demandId}
    </select>

</mapper>
