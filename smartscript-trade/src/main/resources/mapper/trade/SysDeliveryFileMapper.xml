<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smartscript.platform.trade.mapper.SysDeliveryFileMapper">

    <resultMap type="com.smartscript.platform.trade.domain.SysDeliveryFile" id="SysDeliveryFileResult">
        <result property="fileId"     column="file_id" />
        <result property="deliveryId" column="delivery_id" />
        <result property="fileName"   column="file_name" />
        <result property="fileType"   column="file_type" />
        <result property="fileUrl"    column="file_url" />
        <result property="fileSize"   column="file_size" />
        <result property="createBy"   column="create_by" />
        <result property="createTime" column="create_time" />
    </resultMap>

    <select id="selectFilesByDeliveryId" parameterType="Long" resultMap="SysDeliveryFileResult">
        select file_id, delivery_id, file_name, file_type, file_url, file_size, create_by, create_time
        from sys_delivery_file
        where delivery_id = #{deliveryId}
        order by file_id asc
    </select>

    <insert id="insertDeliveryFile" parameterType="com.smartscript.platform.trade.domain.SysDeliveryFile" useGeneratedKeys="true" keyProperty="fileId">
        insert into sys_delivery_file (
            delivery_id, file_name, file_type, file_url, file_size, create_by, create_time
        ) values (
            #{deliveryId}, #{fileName}, #{fileType}, #{fileUrl}, #{fileSize}, #{createBy}, #{createTime}
        )
    </insert>

    <delete id="deleteFilesByDeliveryId" parameterType="Long">
        delete from sys_delivery_file where delivery_id = #{deliveryId}
    </delete>

</mapper>
