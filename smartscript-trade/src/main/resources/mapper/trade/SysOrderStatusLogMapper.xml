<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smartscript.platform.trade.mapper.SysOrderStatusLogMapper">

    <resultMap type="com.smartscript.platform.trade.domain.SysOrderStatusLog" id="SysOrderStatusLogResult">
        <result property="logId"        column="log_id" />
        <result property="orderId"      column="order_id" />
        <result property="fromStatus"   column="from_status" />
        <result property="toStatus"     column="to_status" />
        <result property="operatorId"   column="operator_id" />
        <result property="operatorRole" column="operator_role" />
        <result property="remark"       column="remark" />
        <result property="createdAt"    column="created_at" />
        <result property="createBy"     column="create_by" />
        <result property="createTime"   column="create_time" />
    </resultMap>

    <select id="selectLogsByOrderId" parameterType="Long" resultMap="SysOrderStatusLogResult">
        select log_id, order_id, from_status, to_status, operator_id, operator_role,
               remark, created_at, create_by, create_time
        from sys_order_status_log
        where order_id = #{orderId}
        order by created_at asc
    </select>

    <insert id="insertLog" parameterType="com.smartscript.platform.trade.domain.SysOrderStatusLog" useGeneratedKeys="true" keyProperty="logId">
        insert into sys_order_status_log (
            order_id, from_status, to_status, operator_id, operator_role,
            remark, create_by, create_time
        ) values (
            #{orderId}, #{fromStatus}, #{toStatus}, #{operatorId}, #{operatorRole},
            #{remark}, #{createBy}, #{createTime}
        )
    </insert>

</mapper>
