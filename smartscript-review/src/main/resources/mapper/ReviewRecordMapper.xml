<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smartscript.platform.review.mapper.ReviewRecordMapper">

    <resultMap id="ReviewRecordResult" type="com.smartscript.platform.review.domain.ReviewRecord">
        <id     property="reviewId"     column="review_id"      />
        <result property="targetType"   column="target_type"    />
        <result property="targetId"     column="target_id"      />
        <result property="status"       column="status"         />
        <result property="aiResult"     column="ai_result"      />
        <result property="reviewOpinion" column="review_opinion"/>
        <result property="reviewerId"   column="reviewer_id"    />
        <result property="reviewedAt"   column="review_end_time"    />
        <result property="createBy"     column="create_by"      />
        <result property="createTime"   column="created_at"    />
        <result property="updateBy"     column="update_by"      />
        <result property="updateTime"   column="update_time"    />
        <result property="remark"       column="remark"          />
        <result property="workTitle"    column="work_title"     />
        <result property="workType"     column="work_type"      />
        <result property="genreName"    column="genre_name"     />
        <result property="authorName"   column="author_name"    />
        <result property="userId"       column="user_id"        />
        <result property="aiScore"      column="ai_score"       />
    </resultMap>

    <sql id="selectReviewRecordVo">
        SELECT r.review_id, r.target_type, r.target_id, r.status, r.ai_result,
               r.review_opinion, r.reviewer_id, r.review_end_time,
               r.create_by, r.created_at, r.update_by, r.update_time, r.remark,
               w.title as work_title, w.work_type, c.category_name as genre_name,
               u.nick_name as author_name, w.author_id as user_id,
               CAST(JSON_EXTRACT(r.ai_result, '$.score') AS UNSIGNED) as ai_score
        FROM sys_review_record r
        LEFT JOIN sys_work w ON r.target_id = w.work_id AND r.target_type = 'work'
        LEFT JOIN sys_user u ON w.author_id = u.user_id
        LEFT JOIN sys_category c ON w.genre_id = c.category_id
    </sql>

    <select id="selectReviewRecordList" parameterType="com.smartscript.platform.review.domain.ReviewRecord" resultMap="ReviewRecordResult">
        <include refid="selectReviewRecordVo"/>
        <where>
            <if test="status != null and status != ''">
                AND r.status = #{status}
            </if>
            <if test="targetType != null and targetType != ''">
                AND r.target_type = #{targetType}
            </if>
            <if test="workType != null and workType != ''">
                AND w.work_type = #{workType}
            </if>
            <if test="genreName != null and genreName != ''">
                AND c.category_name = #{genreName}
            </if>
            <if test="beginTime != null and beginTime != ''">
                AND r.created_at &gt;= #{beginTime}
            </if>
            <if test="endTime != null and endTime != ''">
                AND r.created_at &lt;= #{endTime}
            </if>
        </where>
        ORDER BY r.created_at DESC
    </select>

    <select id="selectReviewRecordById" parameterType="Long" resultMap="ReviewRecordResult">
        <include refid="selectReviewRecordVo"/>
        WHERE r.review_id = #{reviewId}
    </select>

    <insert id="insertReviewRecord" parameterType="com.smartscript.platform.review.domain.ReviewRecord" useGeneratedKeys="true" keyProperty="reviewId">
        INSERT INTO sys_review_record
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="targetType != null and targetType != ''">target_type,</if>
            <if test="targetId != null">target_id,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="aiResult != null">ai_result,</if>
            <if test="reviewOpinion != null">review_opinion,</if>
            <if test="reviewerId != null">reviewer_id,</if>
            <if test="reviewedAt != null">review_end_time,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">created_at,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="targetType != null and targetType != ''">#{targetType},</if>
            <if test="targetId != null">#{targetId},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="aiResult != null">#{aiResult},</if>
            <if test="reviewOpinion != null">#{reviewOpinion},</if>
            <if test="reviewerId != null">#{reviewerId},</if>
            <if test="reviewedAt != null">#{reviewedAt},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateReviewRecord" parameterType="com.smartscript.platform.review.domain.ReviewRecord">
        UPDATE sys_review_record
        <trim prefix="SET" suffixOverrides=",">
            <if test="targetType != null and targetType != ''">target_type = #{targetType},</if>
            <if test="targetId != null">target_id = #{targetId},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="reviewResult != null and reviewResult != ''">review_result = #{reviewResult},</if>
            <if test="aiResult != null">ai_result = #{aiResult},</if>
            <if test="aiRiskLevel != null and aiRiskLevel != ''">ai_risk_level = #{aiRiskLevel},</if>
            <if test="aiSensitiveWords != null">ai_sensitive_words = #{aiSensitiveWords},</if>
            <if test="aiStartTime != null">ai_start_time = #{aiStartTime},</if>
            <if test="aiEndTime != null">ai_end_time = #{aiEndTime},</if>
            <if test="reviewOpinion != null">review_opinion = #{reviewOpinion},</if>
            <if test="reviewerId != null">reviewer_id = #{reviewerId},</if>
            <if test="reviewedAt != null">review_end_time = #{reviewedAt},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        WHERE review_id = #{reviewId}
    </update>

    <delete id="deleteReviewRecordById" parameterType="Long">
        DELETE FROM sys_review_record WHERE review_id = #{reviewId}
    </delete>


    <select id="selectStatusGroup" resultType="java.util.Map">
        SELECT status, COUNT(*) AS cnt FROM sys_review_record GROUP BY status
    </select>

</mapper>
