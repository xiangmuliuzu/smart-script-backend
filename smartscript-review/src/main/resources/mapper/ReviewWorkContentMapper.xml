<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smartscript.platform.review.mapper.ReviewWorkContentMapper">

    <resultMap id="workContentMap" type="com.smartscript.platform.review.domain.vo.WorkContentVO">
        <id     property="workId"           column="work_id"/>
        <result property="title"            column="title"/>
        <result property="workType"         column="work_type"/>
        <result property="summary"          column="summary"/>
    </resultMap>

    <resultMap id="workChapterMap" type="com.smartscript.platform.review.domain.vo.WorkChapterVO">
        <id     property="chapterId"    column="chapter_id"/>
        <result property="chapterNo"    column="chapter_no"/>
        <result property="chapterTitle" column="chapter_title"/>
        <result property="content"      column="content"/>
    </resultMap>

    <select id="selectWorkContent" resultMap="workContentMap">
        SELECT work_id, title, work_type, summary
        FROM sys_work
        WHERE work_id = #{workId}
    </select>

    <select id="selectWorkChapters" resultMap="workChapterMap">
        SELECT chapter_id, chapter_no, chapter_title, content
        FROM sys_work_chapter
        WHERE work_id = #{workId}
        ORDER BY chapter_no ASC, chapter_id ASC
    </select>

</mapper>
