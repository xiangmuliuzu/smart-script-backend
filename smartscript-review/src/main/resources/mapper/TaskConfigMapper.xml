<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smartscript.platform.review.mapper.TaskConfigMapper">

    <resultMap id="TaskConfigResult" type="com.smartscript.platform.review.domain.TaskConfig">
        <id     property="taskId"       column="task_id"       />
        <result property="taskName"     column="task_name"     />
        <result property="taskType"     column="task_type"     />
        <result property="taskCode"     column="task_code"     />
        <result property="description"  column="description"   />
        <result property="targetCount"  column="target_count"  />
        <result property="rewardPoints" column="reward_points" />
        <result property="icon"         column="icon"          />
        <result property="sort"         column="sort"          />
        <result property="status"       column="status"        />
        <result property="createBy"     column="create_by"     />
        <result property="createTime"   column="created_at"    />
        <result property="updateBy"     column="update_by"     />
        <result property="updateTime"   column="update_time"   />
        <result property="remark"       column="remark"        />
    </resultMap>

    <sql id="selectTaskConfigVo">
        SELECT task_id, task_name, task_type, task_code, description, target_count,
               reward_points, icon, sort, status, create_by, created_at, update_by, update_time, remark
        FROM sys_task
    </sql>

    <select id="selectTaskConfigList" parameterType="com.smartscript.platform.review.domain.TaskConfig" resultMap="TaskConfigResult">
        <include refid="selectTaskConfigVo"/>
        <where>
            <if test="taskName != null and taskName != ''">
                AND task_name LIKE CONCAT('%', #{taskName}, '%')
            </if>
            <if test="taskType != null and taskType != ''">
                AND task_type = #{taskType}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
        ORDER BY sort ASC, created_at DESC
    </select>

    <select id="selectTaskConfigById" parameterType="Long" resultMap="TaskConfigResult">
        <include refid="selectTaskConfigVo"/>
        WHERE task_id = #{taskId}
    </select>

    <select id="selectTaskConfigByCode" parameterType="String" resultMap="TaskConfigResult">
        <include refid="selectTaskConfigVo"/>
        WHERE task_code = #{taskCode}
    </select>

    <insert id="insertTaskConfig" parameterType="com.smartscript.platform.review.domain.TaskConfig" useGeneratedKeys="true" keyProperty="taskId">
        INSERT INTO sys_task
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="taskName != null and taskName != ''">task_name,</if>
            <if test="taskType != null and taskType != ''">task_type,</if>
            <if test="taskCode != null and taskCode != ''">task_code,</if>
            <if test="description != null">description,</if>
            <if test="targetCount != null">target_count,</if>
            <if test="rewardPoints != null">reward_points,</if>
            <if test="icon != null">icon,</if>
            <if test="sort != null">sort,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="taskName != null and taskName != ''">#{taskName},</if>
            <if test="taskType != null and taskType != ''">#{taskType},</if>
            <if test="taskCode != null and taskCode != ''">#{taskCode},</if>
            <if test="description != null">#{description},</if>
            <if test="targetCount != null">#{targetCount},</if>
            <if test="rewardPoints != null">#{rewardPoints},</if>
            <if test="icon != null">#{icon},</if>
            <if test="sort != null">#{sort},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateTaskConfig" parameterType="com.smartscript.platform.review.domain.TaskConfig">
        UPDATE sys_task
        <trim prefix="SET" suffixOverrides=",">
            <if test="taskName != null and taskName != ''">task_name = #{taskName},</if>
            <if test="taskType != null and taskType != ''">task_type = #{taskType},</if>
            <if test="taskCode != null and taskCode != ''">task_code = #{taskCode},</if>
            <if test="description != null">description = #{description},</if>
            <if test="targetCount != null">target_count = #{targetCount},</if>
            <if test="rewardPoints != null">reward_points = #{rewardPoints},</if>
            <if test="icon != null">icon = #{icon},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        WHERE task_id = #{taskId}
    </update>

    <delete id="deleteTaskConfigById" parameterType="Long">
        DELETE FROM sys_task WHERE task_id = #{taskId}
    </delete>

    <!-- 用户任务领取记录（预留） -->
    <select id="selectUserTaskList" resultType="java.util.Map">
        SELECT
          ut.id AS id,
          ut.user_id AS userId,
          IFNULL(u.nick_name, u.user_name) AS userName,
          ut.task_id AS taskId,
          IFNULL(t.task_name, CONCAT('task-', ut.task_id)) AS taskName,
          ut.progress AS progress,
          ut.is_completed AS isCompleted,
          ut.is_claimed AS isClaimed,
          ut.complete_time AS completeTime,
          ut.claim_time AS claimTime,
          ut.period_date AS periodDate
        FROM sys_user_task ut
        LEFT JOIN sys_user u ON u.user_id = ut.user_id
        LEFT JOIN sys_task t ON t.task_id = ut.task_id
        <where>
          <if test="keyword != null and keyword != ''">
            AND (u.nick_name LIKE CONCAT('%', #{keyword}, '%')
                 OR u.user_name LIKE CONCAT('%', #{keyword}, '%'))
          </if>
          <if test="taskId != null">
            AND ut.task_id = #{taskId}
          </if>
          <if test="periodDate != null and periodDate != ''">
            AND ut.period_date = #{periodDate}
          </if>
        </where>
        ORDER BY ut.period_date DESC, ut.id DESC
    </select>

</mapper>
