<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smartscript.platform.review.mapper.AiQuotaRecordMapper">

    <resultMap id="AiQuotaRecordResult" type="com.smartscript.platform.review.domain.AiQuotaRecord">
        <id     property="recordId"      column="record_id"      />
        <result property="userId"       column="user_id"        />
        <result property="type"         column="change_type"     />
        <result property="amount"       column="change_amount"   />
        <result property="balance"      column="after_balance"   />
        <result property="businessType" column="business_type"   />
        <result property="relatedId"    column="business_id"     />
        <result property="createTime"  column="created_at"     />
        <result property="remark"      column="remark"          />
    </resultMap>

    <sql id="selectAiQuotaRecordVo">
        SELECT record_id, user_id, change_type, change_amount, before_balance,
               after_balance, business_type, business_id, remark, created_at
        FROM sys_ai_quota_record
    </sql>

    <select id="selectAiQuotaRecordList" parameterType="com.smartscript.platform.review.domain.AiQuotaRecord" resultMap="AiQuotaRecordResult">
        <include refid="selectAiQuotaRecordVo"/>
        <where>
            <if test="userId != null">
                AND user_id = #{userId}
            </if>
            <if test="type != null and type != ''">
                AND type = #{type}
            </if>
        </where>
        ORDER BY created_at DESC
    </select>

    <select id="selectAiQuotaRecordById" parameterType="Long" resultMap="AiQuotaRecordResult">
        <include refid="selectAiQuotaRecordVo"/>
        WHERE record_id = #{recordId}
    </select>

    <insert id="insertAiQuotaRecord" parameterType="com.smartscript.platform.review.domain.AiQuotaRecord" useGeneratedKeys="true" keyProperty="recordId">
        INSERT INTO sys_ai_quota_record
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="type != null and type != ''">change_type,</if>
            <if test="amount != null">change_amount,</if>
            <if test="balance != null">after_balance,</if>
            <if test="businessType != null and businessType != ''">business_type,</if>
            <if test="relatedId != null">business_id,</if>
            <if test="createTime != null">created_at,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="type != null and type != ''">#{type},</if>
            <if test="amount != null">#{amount},</if>
            <if test="balance != null">#{balance},</if>
            <if test="businessType != null and businessType != ''">#{businessType},</if>
            <if test="relatedId != null">#{relatedId},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateAiQuotaRecord" parameterType="com.smartscript.platform.review.domain.AiQuotaRecord">
        UPDATE sys_ai_quota_record
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="type != null and type != ''">change_type = #{type},</if>
            <if test="amount != null">change_amount = #{amount},</if>
            <if test="balance != null">after_balance = #{balance},</if>
            <if test="businessType != null and businessType != ''">business_type = #{businessType},</if>
            <if test="relatedId != null">business_id = #{relatedId},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        WHERE record_id = #{recordId}
    </update>

    <delete id="deleteAiQuotaRecordById" parameterType="Long">
        DELETE FROM sys_ai_quota_record WHERE record_id = #{recordId}
    </delete>

    <select id="countTodayCalls" resultType="int">
        SELECT COUNT(*) FROM sys_ai_quota_record WHERE created_at >= CURDATE()
    </select>

    <select id="countFailedCalls" resultType="int">
        SELECT COUNT(*) FROM sys_ai_quota_record WHERE business_type = 'failed'
    </select>

    <select id="countRefundedCalls" resultType="int">
        SELECT COUNT(*) FROM sys_ai_quota_record WHERE change_type = 'refund'
    </select>

</mapper>
