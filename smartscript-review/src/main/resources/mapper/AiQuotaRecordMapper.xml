<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smartscript.platform.review.mapper.AiQuotaRecordMapper">

    <resultMap id="AiQuotaRecordResult" type="com.smartscript.platform.review.domain.AiQuotaRecord">
        <id     property="recordId"      column="record_id"      />
        <result property="accountId"     column="account_id"     />
        <result property="userId"       column="user_id"        />
        <result property="type"         column="type"           />
        <result property="amount"       column="amount"         />
        <result property="balance"      column="balance"        />
        <result property="source"      column="source"         />
        <result property="relatedId"   column="related_id"      />
        <result property="status"      column="status"         />
        <result property="createBy"    column="create_by"       />
        <result property="createTime" column="create_time"     />
        <result property="remark"     column="remark"          />
    </resultMap>

    <sql id="selectAiQuotaRecordVo">
        SELECT record_id, account_id, user_id, type, amount, balance, source,
               related_id, status, create_by, create_time, remark
        FROM sys_ai_quota_record
    </sql>

    <select id="selectAiQuotaRecordList" parameterType="com.smartscript.platform.review.domain.AiQuotaRecord" resultMap="AiQuotaRecordResult">
        <include refid="selectAiQuotaRecordVo"/>
        <where>
            <if test="accountId != null">
                AND account_id = #{accountId}
            </if>
            <if test="userId != null">
                AND user_id = #{userId}
            </if>
            <if test="type != null and type != ''">
                AND type = #{type}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

    <select id="selectAiQuotaRecordById" parameterType="Long" resultMap="AiQuotaRecordResult">
        <include refid="selectAiQuotaRecordVo"/>
        WHERE record_id = #{recordId}
    </select>

    <insert id="insertAiQuotaRecord" parameterType="com.smartscript.platform.review.domain.AiQuotaRecord" useGeneratedKeys="true" keyProperty="recordId">
        INSERT INTO sys_ai_quota_record
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="accountId != null">account_id,</if>
            <if test="userId != null">user_id,</if>
            <if test="type != null and type != ''">type,</if>
            <if test="amount != null">amount,</if>
            <if test="balance != null">balance,</if>
            <if test="source != null">source,</if>
            <if test="relatedId != null">related_id,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="accountId != null">#{accountId},</if>
            <if test="userId != null">#{userId},</if>
            <if test="type != null and type != ''">#{type},</if>
            <if test="amount != null">#{amount},</if>
            <if test="balance != null">#{balance},</if>
            <if test="source != null">#{source},</if>
            <if test="relatedId != null">#{relatedId},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateAiQuotaRecord" parameterType="com.smartscript.platform.review.domain.AiQuotaRecord">
        UPDATE sys_ai_quota_record
        <trim prefix="SET" suffixOverrides=",">
            <if test="accountId != null">account_id = #{accountId},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="type != null and type != ''">type = #{type},</if>
            <if test="amount != null">amount = #{amount},</if>
            <if test="balance != null">balance = #{balance},</if>
            <if test="source != null">source = #{source},</if>
            <if test="relatedId != null">related_id = #{relatedId},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        WHERE record_id = #{recordId}
    </update>

    <delete id="deleteAiQuotaRecordById" parameterType="Long">
        DELETE FROM sys_ai_quota_record WHERE record_id = #{recordId}
    </delete>

</mapper>
