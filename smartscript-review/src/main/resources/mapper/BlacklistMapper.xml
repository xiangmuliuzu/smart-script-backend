<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smartscript.platform.review.mapper.BlacklistMapper">

    <resultMap id="BlacklistResult" type="com.smartscript.platform.review.domain.Blacklist">
        <id     property="id"           column="black_id"       />
        <result property="targetType"   column="target_type"    />
        <result property="targetValue" column="target_value"   />
        <result property="reason"      column="reason"         />
        <result property="status"      column="status"         />
        <result property="createBy"    column="create_by"      />
        <result property="createTime"  column="created_at"    />
        <result property="updateBy"    column="update_by"      />
        <result property="updateTime"  column="update_time"    />
        <result property="remark"      column="remark"         />
    </resultMap>

    <sql id="selectBlacklistVo">
        SELECT black_id, target_type, target_value, reason, status,
               create_by, created_at, update_by, update_time, remark
        FROM sys_blacklist
    </sql>

    <select id="selectBlacklistList" parameterType="com.smartscript.platform.review.domain.Blacklist" resultMap="BlacklistResult">
        <include refid="selectBlacklistVo"/>
        <where>
            <if test="targetType != null and targetType != ''">
                AND target_type = #{targetType}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
        ORDER BY created_at DESC
    </select>

    <select id="selectBlacklistById" parameterType="Long" resultMap="BlacklistResult">
        <include refid="selectBlacklistVo"/>
        WHERE black_id = #{id}
    </select>

    <select id="selectActiveByTarget" resultMap="BlacklistResult">
        <include refid="selectBlacklistVo"/>
        WHERE target_type = #{targetType}
          AND target_value = #{targetValue}
          AND status = 'enabled'
          AND (expire_at IS NULL OR expire_at > NOW())
        LIMIT 1
    </select>

    <insert id="insertBlacklist" parameterType="com.smartscript.platform.review.domain.Blacklist" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_blacklist
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="targetType != null and targetType != ''">target_type,</if>
            <if test="targetValue != null and targetValue != ''">target_value,</if>
            <if test="blackType != null and blackType != ''">black_type,</if>
            <if test="operatorId != null">operator_id,</if>
            <if test="duration != null">duration,</if>
            <if test="reason != null">reason,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">created_at,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="targetType != null and targetType != ''">#{targetType},</if>
            <if test="targetValue != null and targetValue != ''">#{targetValue},</if>
            <if test="blackType != null and blackType != ''">#{blackType},</if>
            <if test="operatorId != null">#{operatorId},</if>
            <if test="duration != null">#{duration},</if>
            <if test="reason != null">#{reason},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateBlacklist" parameterType="com.smartscript.platform.review.domain.Blacklist">
        UPDATE sys_blacklist
        <trim prefix="SET" suffixOverrides=",">
            <if test="targetType != null and targetType != ''">target_type = #{targetType},</if>
            <if test="targetValue != null and targetValue != ''">target_value = #{targetValue},</if>
            <if test="reason != null">reason = #{reason},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        WHERE black_id = #{id}
    </update>

    <delete id="deleteBlacklistById" parameterType="Long">
        DELETE FROM sys_blacklist WHERE black_id = #{id}
    </delete>

</mapper>
