# A3 local integration env template — copy to a private file, do NOT commit secrets.
# Required environment variable NAMES only.

TOKEN_SECRET=
APP_TOKEN_SECRET=
APP_TOKEN_ISSUER=smartscript-app
APP_TOKEN_AUDIENCE=smartscript-app-client
APP_REDIS_KEY_PREFIX=smartscript:local:app-auth:
APP_AUTH_ENV=local
SMS_PROVIDER=mock
APP_SMS_MOCK_CODE=
SMS_COOLDOWN_SECONDS=2
SMS_PHONE_DAILY_LIMIT=4
SMS_IP_HOURLY_LIMIT=50
DB_USERNAME=root
DB_PASSWORD=
DB_URL=jdbc:mysql://localhost:3306/ruoyi_dev_a3_test?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=GMT%2B8
REDIS_HOST=localhost
REDIS_PORT=6379
A3_JAVA=D:\java\jdk-17\bin\java.exe
A3_JAR=D:\build\smart-script-backend\ruoyi-admin\target\ruoyi-admin.jar
