<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smartscript.platform.content.mapper.SysDramaChannelMapper">

	<!--
	  依据：云端 script_platform_dev 库 sys_drama_channel 表。
	  反推处理点：
	  1. created_at/updated_at 由 DB 默认值维护不映射；create_time/update_time 为若依字段正常映射。
	  2. is_auto_distribute/status tinyint ↔ String。
	  3. api_config json 类型，String 透传（MySQL 隐式转换合法 JSON 字符串）。
	  4. channel_id int ↔ Long。
	-->
	<resultMap type="SysDramaChannel" id="SysDramaChannelResult">
		<id     property="channelId"        column="channel_id"        />
		<result property="channelName"      column="channel_name"      />
		<result property="channelCode"      column="channel_code"      />
		<result property="platform"         column="platform"          />
		<result property="accountName"      column="account_name"       />
		<result property="accountId"        column="account_id"        />
		<result property="apiConfig"        column="api_config"         />
		<result property="isAutoDistribute" column="is_auto_distribute" />
		<result property="status"           column="status"            />
		<result property="sort"             column="sort"              />
		<result property="createBy"         column="create_by"         />
		<result property="createTime"       column="create_time"       />
		<result property="updateBy"         column="update_by"         />
		<result property="updateTime"       column="update_time"       />
		<result property="remark"           column="remark"            />
	</resultMap>

	<sql id="selectChannelVo">
		select channel_id, channel_name, channel_code, platform, account_name, account_id,
		       api_config, is_auto_distribute, status, sort,
		       create_by, create_time, update_by, update_time, remark
		from sys_drama_channel
	</sql>

	<select id="selectChannelList" parameterType="SysDramaChannel" resultMap="SysDramaChannelResult">
		<include refid="selectChannelVo"/>
		<where>
			<if test="channelName != null and channelName != ''">
				AND channel_name like concat('%', #{channelName}, '%')
			</if>
			<if test="platform != null and platform != ''">
				AND platform = #{platform}
			</if>
			<if test="status != null and status != ''">
				AND status = #{status}
			</if>
		</where>
		order by sort, channel_id
	</select>

	<select id="selectChannelById" parameterType="Long" resultMap="SysDramaChannelResult">
		<include refid="selectChannelVo"/>
		where channel_id = #{channelId}
	</select>

	<!--
	  新增：is_auto_distribute/status/sort 云端列 NOT NULL 无默认值（反推：由 Service 兜底默认 "0"/"0"/0），
	  此处直接写入。created_at/updated_at 由 DB 默认值维护，不写。
	-->
	<insert id="insertChannel" parameterType="SysDramaChannel" useGeneratedKeys="true" keyProperty="channelId">
		insert into sys_drama_channel(
			channel_name, channel_code, platform, account_name, account_id, api_config,
			is_auto_distribute, status, sort,
			create_by, create_time, remark
		) values (
			#{channelName}, #{channelCode}, #{platform}, #{accountName}, #{accountId}, #{apiConfig},
			#{isAutoDistribute}, #{status}, #{sort},
			#{createBy}, sysdate(), #{remark}
		)
	</insert>

	<!-- 动态更新：仅更新非空字段；改状态复用本语句（单一职责在 Service 层拆分） -->
	<update id="updateChannel" parameterType="SysDramaChannel">
		update sys_drama_channel
		<set>
			<if test="channelName != null and channelName != ''">channel_name = #{channelName},</if>
			<if test="channelCode != null and channelCode != ''">channel_code = #{channelCode},</if>
			<if test="platform != null and platform != ''">platform = #{platform},</if>
			<if test="accountName != null and accountName != ''">account_name = #{accountName},</if>
			<if test="accountId != null and accountId != ''">account_id = #{accountId},</if>
			<if test="apiConfig != null">api_config = #{apiConfig},</if>
			<if test="isAutoDistribute != null and isAutoDistribute != ''">is_auto_distribute = #{isAutoDistribute},</if>
			<if test="status != null and status != ''">status = #{status},</if>
			<if test="sort != null">sort = #{sort},</if>
			<if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
			<if test="remark != null">remark = #{remark},</if>
			update_time = sysdate()
		</set>
		where channel_id = #{channelId}
	</update>

</mapper>
