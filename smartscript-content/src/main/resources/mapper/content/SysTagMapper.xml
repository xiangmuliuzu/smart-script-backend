<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smartscript.platform.content.mapper.SysTagMapper">

	<!--
	  依据：云端 script_platform_dev 库 sys_tag 表（13 字段）。
	  反推处理点：created_at/updated_at 不映射（DB 默认值维护）；
	  status tinyint ↔ String；tag_id int ↔ Long。
	-->
	<resultMap type="SysTag" id="SysTagResult">
		<id     property="tagId"          column="tag_id"          />
		<result property="tagName"        column="tag_name"        />
		<result property="tagType"        column="tag_type"        />
		<result property="useCount"       column="use_count"       />
		<result property="sort"           column="sort"            />
		<result property="status"         column="status"          />
		<result property="createBy"       column="create_by"       />
		<result property="createTime"     column="create_time"     />
		<result property="updateBy"       column="update_by"       />
		<result property="updateTime"     column="update_time"     />
		<result property="remark"         column="remark"          />
	</resultMap>

	<resultMap type="com.smartscript.platform.content.dto.AppWorkTagDto" id="AppWorkTagResult">
		<result property="workId"   column="work_id"   />
		<result property="tagId"    column="tag_id"    />
		<result property="tagName"  column="tag_name"  />
		<result property="tagType"  column="tag_type"  />
	</resultMap>

	<sql id="selectTagVo">
		select tag_id, tag_name, tag_type, use_count, sort, status,
		       create_by, create_time, update_by, update_time, remark
		from sys_tag
	</sql>

	<select id="selectTagList" parameterType="SysTag" resultMap="SysTagResult">
		<include refid="selectTagVo"/>
		<where>
			<if test="tagName != null and tagName != ''">
				AND tag_name like concat('%', #{tagName}, '%')
			</if>
			<if test="tagType != null and tagType != ''">
				AND tag_type = #{tagType}
			</if>
			<if test="status != null and status != ''">
				AND status = #{status}
			</if>
		</where>
		order by sort, tag_id
	</select>

	<select id="selectTagById" parameterType="Long" resultMap="SysTagResult">
		<include refid="selectTagVo"/>
		where tag_id = #{tagId}
	</select>

	<select id="checkTagNameUnique" parameterType="String" resultMap="SysTagResult">
		<include refid="selectTagVo"/>
		where tag_name = #{tagName} limit 1
	</select>

	<!--
	  新增：use_count/sort/status 云端列 NOT NULL 无默认值（反推：由 Service 兜底默认 0/0/'0'），
	  此处直接写入。created_at/updated_at 由 DB 默认值维护，不写。
	-->
	<insert id="insertTag" parameterType="SysTag" useGeneratedKeys="true" keyProperty="tagId">
		insert into sys_tag(
			tag_name, tag_type, use_count, sort, status,
			create_by, create_time, remark
		) values (
			#{tagName}, #{tagType}, #{useCount}, #{sort}, #{status},
			#{createBy}, sysdate(), #{remark}
		)
	</insert>

	<!-- 动态更新：仅更新非空字段；use_count 不允许通过本接口改（由作品关联逻辑维护） -->
	<update id="updateTag" parameterType="SysTag">
		update sys_tag
		<set>
			<if test="tagName != null and tagName != ''">tag_name = #{tagName},</if>
			<if test="tagType != null and tagType != ''">tag_type = #{tagType},</if>
			<if test="sort != null">sort = #{sort},</if>
			<if test="status != null and status != ''">status = #{status},</if>
			<if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
			<if test="remark != null">remark = #{remark},</if>
			update_time = sysdate()
		</set>
		where tag_id = #{tagId}
	</update>

	<!-- 物理删除（无文档依据，反推：若依原生 sys_post 同为物理删除） -->
	<delete id="deleteTagByIds">
		delete from sys_tag where tag_id in
		<foreach item="tagId" collection="array" open="(" separator="," close=")">
			#{tagId}
		</foreach>
	</delete>

	<!--
	  统计有多少作品引用了该标签（删除前校验）。
	  仅统计未删除作品（is_deleted = 0），与 use_count 口径一致；
	  被引用的标签不允许删除，避免 sys_work_tag 留下孤儿关联、作品静默丢标签。
	-->
	<select id="countWorkByTagId" resultType="int">
		select count(1)
		from sys_work_tag wt
		join sys_work w on w.work_id = wt.work_id and w.is_deleted = 0
		where wt.tag_id = #{tagId}
	</select>

	<!--
	  App 侧标签列表（只读，书城筛选用）。
	  固定条件：status = '0'（PC 端口径：'0'=正常 '1'=停用，见标签管理页）；
	  按 sort 升序（位次决定展示顺序）。
	  说明：use_count 有真实值后若仍按 use_count 降序，热度会完全覆盖位次，使 PC 端维护的位次在 App 端失效。
	  categoryId 有值时收敛为该分类下已上架作品关联过的标签（接口文档表 2-126 的 category_id 入参）。
	-->
	<select id="selectAppTagList" resultMap="SysTagResult">
		<include refid="selectTagVo"/>
		<where>
			status = '0'
			<if test="tagType != null and tagType != ''">
				AND tag_type = #{tagType}
			</if>
			<if test="categoryId != null">
				AND exists (
					select 1 from sys_work_tag wt
					join sys_work w on w.work_id = wt.work_id
					where wt.tag_id = sys_tag.tag_id
					  and w.genre_id = #{categoryId}
					<include refid="com.smartscript.platform.content.mapper.SysContentWorkMapper.readerVisibleWork">
						<property name="alias" value="w"/>
					</include>
				)
			</if>
		</where>
		order by sort, tag_id
	</select>

	<!--
	  按作品批量查询关联标签（App 侧只读）。
	  固定条件：仅启用标签（status = '0'，与 selectAppTagList 同口径）；
	  按 sort 升序（标签展示顺序）。入参 workIds 由 Service 保证非空。
	-->
	<select id="selectWorkTagRows" resultMap="AppWorkTagResult">
		select wt.work_id as work_id,
		       t.tag_id   as tag_id,
		       t.tag_name as tag_name,
		       t.tag_type as tag_type
		from sys_work_tag wt
		join sys_tag t on t.tag_id = wt.tag_id
		where wt.work_id in
		<foreach item="workId" collection="workIds" open="(" separator="," close=")">
			#{workId}
		</foreach>
		  and t.status = '0'
		order by t.sort, t.tag_id
	</select>

	<!--
	  清空某作品的全部标签关联（作品标签全量覆盖的第一步）。
	  依据：接口文档 2.3.3 tagIds「全量覆盖」语义 + 附件5.1 表3-13 sys_work_tag。
	-->
	<delete id="deleteWorkTagByWorkId">
		delete from sys_work_tag where work_id = #{workId}
	</delete>

	<!--
	  批量写入作品标签关联。
	  唯一索引 uk_work_tag(work_id, tag_id) 由调用方先去重保证；created_at 非空且有默认值，这里显式写入。
	-->
	<insert id="batchInsertWorkTag">
		insert into sys_work_tag (work_id, tag_id, created_at, create_by)
		values
		<foreach item="tagId" collection="tagIds" separator=",">
			(#{workId}, #{tagId}, sysdate(), #{createBy})
		</foreach>
	</insert>

	<!-- 前移：当前标签从 oldSort 移到 newSort（newSort < oldSort），中间标签整体后移一位 -->
	<update id="shiftTagSortForward">
		update sys_tag set sort = sort + 1
		where sort >= #{newSort} and sort &lt; #{oldSort} <if test="excludeId != null">and tag_id != #{excludeId}</if>
	</update>

	<!-- 后移：当前标签从 oldSort 移到 newSort（newSort > oldSort），中间标签整体前移一位 -->
	<update id="shiftTagSortBackward">
		update sys_tag set sort = sort - 1
		where sort > #{oldSort} and sort &lt;= #{newSort} <if test="excludeId != null">and tag_id != #{excludeId}</if>
	</update>

	<!-- 当前最大位次（空表返回 null）：新增标签时用于追加到末尾，避免历史「兜底 0」造成的位次重复 -->
	<select id="selectMaxSort" resultType="java.lang.Integer">
		select max(sort) from sys_tag
	</select>

	<!-- 占用指定位次的其它标签数（excludeId 传自身ID时排除自己）：位次唯一性强校验用 -->
	<select id="countBySort" resultType="int">
		select count(*) from sys_tag
		where sort = #{sort}
		<if test="excludeId != null">and tag_id != #{excludeId}</if>
	</select>

	<!-- 删除后紧缩：把 sort 大于被删位次的其它标签整体前移一位，消除删除留下的位次空洞 -->
	<update id="shiftSortAfterDelete">
		update sys_tag set sort = sort - 1
		where sort > #{deletedSort}
	</update>

	<!--
	  全量刷新标签使用数量：use_count = 该标签被「未删除作品」引用的行数，无引用置 0。
	  与迁移脚本 B_20261018_003 同一口径；作品标签全量覆盖、作品逻辑删除后调用。
	-->
	<update id="syncTagUseCount">
		update sys_tag t
		left join (
			select wt.tag_id as tag_id, count(*) as c
			from sys_work_tag wt
			join sys_work w on w.work_id = wt.work_id and w.is_deleted = 0
			group by wt.tag_id
		) x on x.tag_id = t.tag_id
		set t.use_count = ifnull(x.c, 0)
	</update>

	<!--
	  锁定位次写入作用域：对整表行加排他锁，串行化并发的位次维护事务。
	  位次是整表共享的槽位序列，并发下「判占用 → 腾位 → 写入」的中间结果彼此不可见，
	  两个事务都可能通过写入后唯一校验而落库重复位次；加锁后同一时刻只有一个位次事务在跑。
	  仅取锁语义，调用方忽略返回的 ID 列表。
	-->
	<select id="lockSortScope" resultType="java.lang.Long">
		select tag_id from sys_tag order by tag_id for update
	</select>

</mapper>
