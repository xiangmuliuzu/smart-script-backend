<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smartscript.platform.content.mapper.SysContentWorkMapper">

	<!--
	  依据：云端 script_platform_dev 库 sys_work 表（附件5.1 表3-14，42 字段含若依5通用字段）。
	  反推处理点：
	  1. created_at/updated_at 由 DB 默认值维护不映射；create_time/update_time 为若依字段正常映射。
	  2. status varchar(20) 原样持有；trade_enabled/is_free/preview_enabled/is_copyrighted/is_deleted
	     tinyint ↔ String。
	  3. ext_json json 类型，String 透传（MySQL 隐式转换合法 JSON 字符串）。
	  4. authorName/genreName 为 JOIN 扩展字段（sys_user.nick_name / sys_category.category_name）。
	  5. recommendStatus/showScope 为书城 ext_json 解析扩展字段（JSON_EXTRACT）。
	-->
	<resultMap type="SysContentWork" id="SysWorkResult">
		<id     property="workId"           column="work_id"           />
		<result property="title"            column="title"             />
		<result property="cover"            column="cover"             />
		<result property="authorId"         column="author_id"         />
		<result property="genreId"          column="genre_id"          />
		<result property="workType"         column="work_type"         />
		<result property="uploadType"       column="upload_type"       />
		<result property="lengthType"       column="length_type"       />
		<result property="summary"          column="summary"           />
		<result property="coreSetting"      column="core_setting"      />
		<result property="characterSetting" column="character_setting" />
		<result property="price"            column="price"             />
		<result property="tradeType"        column="trade_type"        />
		<result property="tradeEnabled"     column="trade_enabled"     />
		<result property="negotiableMin"    column="negotiable_min"    />
		<result property="negotiableMax"    column="negotiable_max"    />
		<result property="quoteValidDays"   column="quote_valid_days"  />
		<result property="wordCount"        column="word_count"        />
		<result property="episodeCount"     column="episode_count"     />
		<result property="duration"         column="duration"          />
		<result property="isFree"           column="is_free"           />
		<result property="previewEnabled"   column="preview_enabled"   />
		<result property="previewEpisodes"  column="preview_episodes"  />
		<result property="status"           column="status"            />
		<result property="isCopyrighted"    column="is_copyrighted"    />
		<result property="viewCount"        column="view_count"        />
		<result property="favoriteCount"    column="favorite_count"    />
		<result property="saleCount"        column="sale_count"        />
		<result property="rating"           column="rating"            />
		<result property="qualityLevel"     column="quality_level"     />
		<result property="reviewerId"       column="reviewer_id"       />
		<result property="reviewTime"       column="review_time"       />
		<result property="rejectReason"     column="reject_reason"     />
		<result property="extJson"          column="ext_json"          />
		<result property="isDeleted"        column="is_deleted"        />
		<result property="createBy"         column="create_by"         />
		<result property="createTime"       column="create_time"       />
		<result property="updateBy"         column="update_by"         />
		<result property="updateTime"       column="update_time"       />
		<result property="remark"           column="remark"            />
		<result property="authorName"       column="author_name"       />
		<result property="genreName"        column="genre_name"        />
		<result property="recommendStatus"  column="recommend_status"  />
		<result property="showScope"        column="show_scope"        />
	</resultMap>

	<!-- 作品管理列表：含 authorName/genreName，全字段 -->
	<sql id="selectWorkVo">
		select w.work_id, w.title, w.cover, w.author_id, w.genre_id, w.work_type, w.upload_type,
		       w.length_type, w.summary, w.core_setting, w.character_setting,
		       w.price, w.trade_type, w.trade_enabled, w.negotiable_min, w.negotiable_max,
		       w.quote_valid_days, w.word_count, w.episode_count, w.duration,
		       w.is_free, w.preview_enabled, w.preview_episodes,
		       w.status, w.is_copyrighted, w.view_count, w.favorite_count, w.sale_count,
		       w.rating, w.quality_level, w.reviewer_id, w.review_time, w.reject_reason,
		       w.ext_json, w.is_deleted,
		       w.create_by, w.create_time, w.update_by, w.update_time, w.remark,
		       u.nick_name as author_name,
		       c.category_name as genre_name
		from sys_work w
		left join sys_user u on u.user_id = w.author_id
		left join sys_category c on c.category_id = w.genre_id
		where w.is_deleted = 0
	</sql>

	<select id="selectWorkList" parameterType="SysContentWork" resultMap="SysWorkResult">
		<include refid="selectWorkVo"/>
		<if test="title != null and title != ''">
			AND w.title like concat('%', #{title}, '%')
		</if>
		<if test="authorId != null">
			AND w.author_id = #{authorId}
		</if>
		<if test="genreId != null">
			AND w.genre_id = #{genreId}
		</if>
		<if test="status != null and status != ''">
			AND w.status = #{status}
		</if>
		<if test="workType != null and workType != ''">
			AND w.work_type = #{workType}
		</if>
		<if test="tradeType != null and tradeType != ''">
			AND w.trade_type = #{tradeType}
		</if>
		order by w.create_time desc
	</select>

	<select id="selectWorkById" parameterType="Long" resultMap="SysWorkResult">
		<include refid="selectWorkVo"/>
		and w.work_id = #{workId}
	</select>

	<!-- 用户端「我的作品」列表：本人作品，按更新时间倒序 -->
	<select id="selectWorkListByAuthor" parameterType="Long" resultMap="SysWorkResult">
		<include refid="selectWorkVo"/>
		and w.author_id = #{authorId}
		order by w.update_time desc
	</select>

	<!-- 书城列表：含从 ext_json 解析的 recommendStatus/showScope -->
	<sql id="selectBookstoreVo">
		select w.work_id, w.title, w.cover, w.author_id, w.status, w.trade_enabled,
		       w.trade_type, w.price, w.word_count, w.episode_count, w.view_count,
		       w.favorite_count, w.sale_count, w.rating, w.ext_json,
		       w.create_by, w.create_time, w.update_by, w.update_time, w.remark,
		       u.nick_name as author_name,
		       JSON_UNQUOTE(JSON_EXTRACT(w.ext_json, '$.recommendStatus')) as recommend_status,
		       JSON_EXTRACT(w.ext_json, '$.showScope') as show_scope
		from sys_work w
		left join sys_user u on u.user_id = w.author_id
		where w.is_deleted = 0
	</sql>

	<select id="selectBookstoreList" parameterType="SysContentWork" resultMap="SysWorkResult">
		<include refid="selectBookstoreVo"/>
		<if test="title != null and title != ''">
			AND w.title like concat('%', #{title}, '%')
		</if>
		<if test="recommendStatus != null and recommendStatus != ''">
			AND JSON_UNQUOTE(JSON_EXTRACT(w.ext_json, '$.recommendStatus')) = #{recommendStatus}
		</if>
		<if test="status != null and status != ''">
			AND w.status = #{status}
		</if>
		<if test="tradeEnabled != null and tradeEnabled != ''">
			AND w.trade_enabled = #{tradeEnabled}
		</if>
		order by w.create_time desc
	</select>

	<select id="selectBookstoreById" parameterType="Long" resultMap="SysWorkResult">
		<include refid="selectBookstoreVo"/>
		and w.work_id = #{workId}
	</select>

	<!-- 修改上下架状态（单一职责：仅改 status） -->
	<update id="updateWorkStatus" parameterType="SysContentWork">
		update sys_work
		set status = #{status},
		    update_by = #{updateBy},
		    update_time = sysdate()
		where work_id = #{workId}
	</update>

	<!-- 修改交易开关（单一职责：仅改 trade_enabled） -->
	<update id="updateWorkTradeEnabled" parameterType="SysContentWork">
		update sys_work
		set trade_enabled = #{tradeEnabled},
		    update_by = #{updateBy},
		    update_time = sysdate()
		where work_id = #{workId}
	</update>

	<!-- 修改扩展JSON（单一职责：整体替换 ext_json） -->
	<update id="updateWorkExtJson" parameterType="SysContentWork">
		update sys_work
		set ext_json = #{extJson},
		    update_by = #{updateBy},
		    update_time = sysdate()
		where work_id = #{workId}
	</update>

	<!-- ==================== App 侧只读（B 模块书城浏览主链路） ==================== -->
	<!--
	  依据：云端 script_platform_dev 库 sys_work 表 + 接口文档 2.7.1/2.7.2。
	  反推处理点：
	  1. AppWorkDto/AppRankingItem 在 dto 包，不在 typeAliasesPackage 扫描范围，故用全限定类名。
	  2. 固定硬条件 is_deleted = 0 AND status = 'on_shelf'（书城只面向用户，只展示已上架作品）。
	  3. tagId 过滤走 sys_work_tag EXISTS 子查询（作品标签关联表，附件5.1 表3-13）。
	  4. sort 由控制层收敛为白名单值，此处仅做分支排序，不拼接任意列名。
	-->
	<resultMap type="com.smartscript.platform.content.dto.AppWorkDto" id="AppWorkDtoResult">
		<id     property="workId"           column="work_id"           />
		<result property="title"            column="title"             />
		<result property="cover"            column="cover"             />
		<result property="authorId"         column="author_id"         />
		<result property="authorName"       column="author_name"       />
		<result property="genreId"          column="genre_id"          />
		<result property="genreName"        column="genre_name"        />
		<result property="workType"         column="work_type"         />
		<result property="uploadType"       column="upload_type"       />
		<result property="lengthType"       column="length_type"       />
		<result property="summary"          column="summary"           />
		<result property="coreSetting"      column="core_setting"      />
		<result property="characterSetting" column="character_setting" />
		<result property="price"            column="price"             />
		<result property="tradeType"        column="trade_type"        />
		<result property="tradeEnabled"     column="trade_enabled"     />
		<result property="wordCount"        column="word_count"        />
		<result property="episodeCount"     column="episode_count"     />
		<result property="duration"         column="duration"          />
		<result property="isFree"           column="is_free"           />
		<result property="previewEnabled"   column="preview_enabled"   />
		<result property="previewEpisodes"  column="preview_episodes"  />
		<result property="status"           column="status"            />
		<result property="isCopyrighted"    column="is_copyrighted"    />
		<result property="qualityLevel"     column="quality_level"     />
		<result property="viewCount"        column="view_count"        />
		<result property="favoriteCount"    column="favorite_count"    />
		<result property="saleCount"        column="sale_count"        />
		<result property="rating"           column="rating"            />
		<result property="createTime"       column="create_time"       />
	</resultMap>

	<resultMap type="com.smartscript.platform.content.dto.AppRankingItem" id="AppRankingItemResult">
		<result property="workId"          column="work_id"          />
		<result property="title"           column="title"            />
		<result property="cover"           column="cover"            />
		<result property="authorName"      column="author_name"      />
		<result property="genreName"       column="genre_name"       />
		<result property="viewCount"       column="view_count"       />
		<result property="favoriteCount"   column="favorite_count"   />
		<result property="saleCount"       column="sale_count"       />
		<result property="rating"          column="rating"           />
		<result property="wordCount"       column="word_count"       />
		<result property="episodeCount"    column="episode_count"    />
		<result property="price"           column="price"            />
		<result property="isFree"          column="is_free"          />
	</resultMap>

	<!-- 列表公共列：不含 core_setting/character_setting（长文本，仅详情下发） -->
	<sql id="selectAppWorkVo">
		select w.work_id, w.title, w.cover, w.author_id, w.genre_id, w.work_type, w.upload_type,
		       w.length_type, w.summary, w.price, w.trade_type, w.trade_enabled,
		       w.word_count, w.episode_count, w.duration, w.is_free, w.preview_enabled,
		       w.preview_episodes, w.status, w.is_copyrighted, w.quality_level,
		       w.view_count, w.favorite_count, w.sale_count, w.rating, w.create_time,
		       u.nick_name as author_name,
		       c.category_name as genre_name
		from sys_work w
		left join sys_user u on u.user_id = w.author_id
		left join sys_category c on c.category_id = w.genre_id
		where w.is_deleted = 0 and w.status = 'on_shelf'
	</sql>

	<select id="selectAppWorkList" parameterType="com.smartscript.platform.content.dto.AppWorkQuery" resultMap="AppWorkDtoResult">
		<include refid="selectAppWorkVo"/>
		<if test="keyword != null and keyword != ''">
			AND w.title like concat('%', #{keyword}, '%')
		</if>
		<if test="categoryId != null">
			AND w.genre_id = #{categoryId}
		</if>
		<if test="tagId != null">
			AND exists (select 1 from sys_work_tag wt where wt.work_id = w.work_id and wt.tag_id = #{tagId})
		</if>
		<choose>
			<when test='sort != null and sort == "view"'>order by w.view_count desc, w.work_id desc</when>
			<when test='sort != null and sort == "favorite"'>order by w.favorite_count desc, w.work_id desc</when>
			<when test='sort != null and sort == "sale"'>order by w.sale_count desc, w.work_id desc</when>
			<when test='sort != null and sort == "rating"'>order by w.rating desc, w.work_id desc</when>
			<when test='sort != null and sort == "price_asc"'>order by w.price asc, w.work_id desc</when>
			<when test='sort != null and sort == "price_desc"'>order by w.price desc, w.work_id desc</when>
			<otherwise>order by w.create_time desc, w.work_id desc</otherwise>
		</choose>
	</select>

	<select id="selectAppWorkById" parameterType="Long" resultMap="AppWorkDtoResult">
		select w.work_id, w.title, w.cover, w.author_id, w.genre_id, w.work_type, w.upload_type,
		       w.length_type, w.summary, w.core_setting, w.character_setting,
		       w.price, w.trade_type, w.trade_enabled,
		       w.word_count, w.episode_count, w.duration, w.is_free, w.preview_enabled,
		       w.preview_episodes, w.status, w.is_copyrighted, w.quality_level,
		       w.view_count, w.favorite_count, w.sale_count, w.rating, w.create_time,
		       u.nick_name as author_name,
		       c.category_name as genre_name
		from sys_work w
		left join sys_user u on u.user_id = w.author_id
		left join sys_category c on c.category_id = w.genre_id
		where w.is_deleted = 0 and w.status = 'on_shelf'
		  and w.work_id = #{workId}
	</select>

	<!-- 榜单：type 由控制层收敛为 view/favorite/sale/rating，此处仅分支排序 -->
	<select id="selectAppRankingList" resultMap="AppRankingItemResult">
		select w.work_id, w.title, w.cover, w.genre_id, w.price, w.is_free,
		       w.word_count, w.episode_count, w.view_count, w.favorite_count,
		       w.sale_count, w.rating,
		       u.nick_name as author_name,
		       c.category_name as genre_name
		from sys_work w
		left join sys_user u on u.user_id = w.author_id
		left join sys_category c on c.category_id = w.genre_id
		where w.is_deleted = 0 and w.status = 'on_shelf'
		<choose>
			<when test='type != null and type == "favorite"'>order by w.favorite_count desc, w.work_id desc</when>
			<when test='type != null and type == "sale"'>order by w.sale_count desc, w.work_id desc</when>
			<when test='type != null and type == "rating"'>order by w.rating desc, w.work_id desc</when>
			<otherwise>order by w.view_count desc, w.work_id desc</otherwise>
		</choose>
				limit #{limit}
	</select>

	<!-- 用户端修改作品基本信息（title/summary/genre_id，状态校验在服务层） -->
	<update id="updateWorkBaseInfo" parameterType="SysContentWork">
		update sys_work
		<trim prefix="SET" suffixOverrides=",">
			<if test="title != null and title != ''">title = #{title},</if>
			<if test="summary != null">summary = #{summary},</if>
			<if test="genreId != null">genre_id = #{genreId},</if>
			<if test="updateBy != null">update_by = #{updateBy},</if>
			<if test="updateTime != null">update_time = #{updateTime},</if>
		</trim>
		where work_id = #{workId}
	</update>

</mapper>
