<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smartscript.platform.content.mapper.AppAiWriteRecordMapper">

	<!--
	  依据：云端 script_platform_dev 库 sys_ai_write_record 表（附件5.1 表3-22）。
	  反推处理点：
	  1. record_id 为 bigint auto_increment，useGeneratedKeys 回填插入对象 recordId。
	  2. created_at 有 DEFAULT CURRENT_TIMESTAMP，仍显式写 now()，不依赖库默认值差异；
	     若依审计列 create_time 一并写 now()，便于后台列表按统一口径排序。
	  3. DTO 在 dto 包（typeAliasesPackage 只扫 **.domain），故 parameterType 用全限定类名。
	  4. 查询强制带 user_id，按 created_at 倒序，分页由调用方 PageHelper 驱动。
	-->
	<insert id="insertWriteRecord"
	        parameterType="com.smartscript.platform.content.dto.AppAiWriteRecordInsert"
	        useGeneratedKeys="true" keyProperty="recordId">
		insert into sys_ai_write_record
			(user_id, work_id, title, write_type, pov, language_style, pace,
			 input_prompt, output_content, word_count, ai_model, tokens_used, status,
			 created_at, create_time)
		values
			(#{userId}, #{workId}, #{title}, #{writeType}, #{pov}, #{languageStyle}, #{pace},
			 #{inputPrompt}, #{outputContent}, #{wordCount}, #{aiModel}, #{tokensUsed}, #{status},
			 now(), now())
	</insert>

	<resultMap type="com.smartscript.platform.content.dto.AppAiWriteRecordItem" id="AppAiWriteRecordItemResult">
		<id     property="recordId"      column="record_id"      />
		<result property="title"         column="title"          />
		<result property="writeType"     column="write_type"     />
		<result property="inputPrompt"   column="input_prompt"   />
		<result property="outputContent" column="output_content" />
		<result property="wordCount"     column="word_count"     />
		<result property="aiModel"       column="ai_model"       />
		<result property="status"        column="status"         />
		<result property="createdAt"     column="created_at"     />
	</resultMap>

	<select id="selectWriteRecordsByUser" resultMap="AppAiWriteRecordItemResult">
		select record_id, title, write_type, input_prompt, output_content,
		       word_count, ai_model, status, created_at
		from sys_ai_write_record
		where user_id = #{userId}
		order by created_at desc, record_id desc
	</select>

</mapper>