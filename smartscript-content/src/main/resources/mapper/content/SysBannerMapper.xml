<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smartscript.platform.content.mapper.SysBannerMapper">

	<!--
	  依据：云端 script_platform_dev 库 sys_banner 表（附件5.1 表3-88）。
	  反推处理点：
	  1. created_at/updated_at 由 DB 默认值维护不映射；create_time/update_time 为若依字段正常映射。
	  2. status varchar(20) 原样持有（非 tinyint）。
	  3. 主键 banner_id bigint ↔ Long。
	-->
	<resultMap type="SysBanner" id="SysBannerResult">
		<id     property="bannerId"     column="banner_id"     />
		<result property="title"        column="title"         />
		<result property="imageUrl"     column="image_url"     />
		<result property="linkType"     column="link_type"     />
		<result property="linkId"       column="link_id"       />
		<result property="linkUrl"      column="link_url"      />
		<result property="position"     column="position"      />
		<result property="sortOrder"    column="sort_order"    />
		<result property="status"       column="status"        />
		<result property="startTime"    column="start_time"    />
		<result property="endTime"      column="end_time"      />
		<result property="createBy"     column="create_by"     />
		<result property="createTime"   column="create_time"   />
		<result property="updateBy"     column="update_by"     />
		<result property="updateTime"   column="update_time"   />
		<result property="remark"       column="remark"        />
	</resultMap>

	<sql id="selectBannerVo">
		select banner_id, title, image_url, link_type, link_id, link_url,
		       position, sort_order, status, start_time, end_time,
		       create_by, create_time, update_by, update_time, remark
		from sys_banner
	</sql>

	<select id="selectBannerList" parameterType="SysBanner" resultMap="SysBannerResult">
		<include refid="selectBannerVo"/>
		<where>
			<if test="title != null and title != ''">
				AND title like concat('%', #{title}, '%')
			</if>
			<if test="position != null and position != ''">
				AND position = #{position}
			</if>
			<if test="status != null and status != ''">
				AND status = #{status}
			</if>
		</where>
		order by position, sort_order, banner_id
	</select>

	<select id="selectBannerById" parameterType="Long" resultMap="SysBannerResult">
		<include refid="selectBannerVo"/>
		where banner_id = #{bannerId}
	</select>

	<!--
	  App 首页 Banner 轮播（只读，接口文档 2.7.13 表 2-93）。
	  固定条件：status = 'on' 且在展示时间窗内（start_time/end_time 为 NULL 视为不限制）；
	  position 为可选筛选（PC 端示例值如 home_top）。
	-->
	<select id="selectAppBannerList" parameterType="SysBanner" resultMap="SysBannerResult">
		<include refid="selectBannerVo"/>
		<where>
			status = 'on'
			and (start_time is null or start_time &lt;= sysdate())
			and (end_time is null or end_time &gt;= sysdate())
			<if test="position != null and position != ''">
				AND position = #{position}
			</if>
		</where>
		order by position, sort_order, banner_id
	</select>

</mapper>
