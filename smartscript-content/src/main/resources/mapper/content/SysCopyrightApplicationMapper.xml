<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smartscript.platform.content.mapper.SysCopyrightApplicationMapper">
    
    <resultMap type="SysCopyrightApplication" id="SysCopyrightApplicationResult">
        <result property="applyId"    column="apply_id"    />
        <result property="workId"    column="work_id"    />
        <result property="userId"    column="user_id"    />
        <result property="applyNo"    column="apply_no"    />
        <result property="copyrightCenter"    column="copyright_center"    />
        <result property="status"    column="status"    />
        <result property="syncStatus"    column="sync_status"    />
        <result property="externalNo"    column="external_apply_no"    />
        <result property="submitTime"    column="submit_time"    />
        <result property="certNo"    column="cert_no"    />
        <result property="certTime"    column="cert_time"    />
        <result property="rejectReason"    column="reject_reason"    />
        <result property="attachmentUrl"    column="attachment_url"    />
        <result property="originalityProof"    column="originality_proof"    />
        <result property="authorIdentityDoc"    column="author_identity_doc"    />
        <result property="creationProcess"    column="creation_process"    />
        <result property="otherProof"    column="other_proof"    />
        <result property="configId"    column="config_id"    />
        <result property="centerName"    column="center_name"    />
        <result property="workName"    column="work_name"    />
        <result property="remark"    column="remark"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectCopyrightApplicationVo">
        select a.apply_id, a.work_id, a.user_id, a.apply_no, a.copyright_center, a.status, a.sync_status, a.external_apply_no, a.submit_time, 
               a.cert_no, a.cert_time, a.reject_reason, a.attachment_url, a.originality_proof, a.author_identity_doc, a.creation_process, a.other_proof,
               a.config_id, a.remark, a.create_time, a.update_time,
               c.center_name,
               w.title as work_name
        from sys_copyright_application a
        left join sys_copyright_center_config c on a.config_id = c.config_id
        left join sys_work w on a.work_id = w.work_id
    </sql>

    <select id="selectCopyrightApplicationList" parameterType="SysCopyrightApplication" resultMap="SysCopyrightApplicationResult">
        <include refid="selectCopyrightApplicationVo"/>
        <where>  
            <if test="workId != null "> and a.work_id = #{workId}</if>
            <if test="userId != null "> and a.user_id = #{userId}</if>
            <if test="status != null  and status != ''"> and a.status = #{status}</if>
            <if test="workName != null and workName != ''"> and w.title like concat('%', #{workName}, '%')</if>
            <if test="externalNo != null  and externalNo != ''"> and a.external_apply_no = #{externalNo}</if>
            <if test="configId != null "> and a.config_id = #{configId}</if>
            <if test="params.statusList != null and params.statusList != ''">
                and a.status in
                <foreach collection="params.statusList.split(',')" item="item" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>
        </where>
        order by a.create_time desc
    </select>
    
    <select id="selectCopyrightApplicationByApplyId" parameterType="Long" resultMap="SysCopyrightApplicationResult">
        <include refid="selectCopyrightApplicationVo"/>
        where a.apply_id = #{applyId}
    </select>

    <select id="selectApplicationByWorkId" parameterType="Long" resultMap="SysCopyrightApplicationResult">
        <include refid="selectCopyrightApplicationVo"/>
        where a.work_id = #{workId}
        order by a.create_time desc
        limit 1
    </select>
        
    <insert id="insertCopyrightApplication" parameterType="SysCopyrightApplication" useGeneratedKeys="true" keyProperty="applyId">
        insert into sys_copyright_application
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="workId != null">work_id,</if>
            <if test="userId != null">user_id,</if>
            <if test="applyNo != null and applyNo != ''">apply_no,</if>
            <if test="copyrightCenter != null and copyrightCenter != ''">copyright_center,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="syncStatus != null and syncStatus != ''">sync_status,</if>
            <if test="externalNo != null">external_apply_no,</if>
            <if test="submitTime != null">submit_time,</if>
            <if test="certNo != null">cert_no,</if>
            <if test="certTime != null">cert_time,</if>
            <if test="rejectReason != null">reject_reason,</if>
            <if test="attachmentUrl != null">attachment_url,</if>
            <if test="originalityProof != null">originality_proof,</if>
            <if test="authorIdentityDoc != null">author_identity_doc,</if>
            <if test="creationProcess != null">creation_process,</if>
            <if test="otherProof != null">other_proof,</if>
            <if test="configId != null">config_id,</if>
            <if test="remark != null">remark,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="workId != null">#{workId},</if>
            <if test="userId != null">#{userId},</if>
            <if test="applyNo != null and applyNo != ''">#{applyNo},</if>
            <if test="copyrightCenter != null and copyrightCenter != ''">#{copyrightCenter},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="syncStatus != null and syncStatus != ''">#{syncStatus},</if>
            <if test="externalNo != null">#{externalNo},</if>
            <if test="submitTime != null">#{submitTime},</if>
            <if test="certNo != null">#{certNo},</if>
            <if test="certTime != null">#{certTime},</if>
            <if test="rejectReason != null">#{rejectReason},</if>
            <if test="attachmentUrl != null">#{attachmentUrl},</if>
            <if test="originalityProof != null">#{originalityProof},</if>
            <if test="authorIdentityDoc != null">#{authorIdentityDoc},</if>
            <if test="creationProcess != null">#{creationProcess},</if>
            <if test="otherProof != null">#{otherProof},</if>
            <if test="configId != null">#{configId},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateCopyrightApplication" parameterType="SysCopyrightApplication">
        update sys_copyright_application
        <trim prefix="SET" suffixOverrides=",">
            <if test="workId != null">work_id = #{workId},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="externalNo != null">external_apply_no = #{externalNo},</if>
            <if test="submitTime != null">submit_time = #{submitTime},</if>
            <if test="certNo != null">cert_no = #{certNo},</if>
            <if test="certTime != null">cert_time = #{certTime},</if>
            <if test="rejectReason != null">reject_reason = #{rejectReason},</if>
            <if test="attachmentUrl != null">attachment_url = #{attachmentUrl},</if>
            <if test="originalityProof != null">originality_proof = #{originalityProof},</if>
            <if test="authorIdentityDoc != null">author_identity_doc = #{authorIdentityDoc},</if>
            <if test="creationProcess != null">creation_process = #{creationProcess},</if>
            <if test="otherProof != null">other_proof = #{otherProof},</if>
            <if test="configId != null">config_id = #{configId},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where apply_id = #{applyId}
    </update>

    <delete id="deleteCopyrightApplicationByApplyId" parameterType="Long">
        delete from sys_copyright_application where apply_id = #{applyId}
    </delete>

    <delete id="deleteCopyrightApplicationByApplyIds" parameterType="String">
        delete from sys_copyright_application where apply_id in 
        <foreach item="applyId" collection="array" open="(" separator="," close=")">
            #{applyId}
        </foreach>
    </delete>
</mapper>
