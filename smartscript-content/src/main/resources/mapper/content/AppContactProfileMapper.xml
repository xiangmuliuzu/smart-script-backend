<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smartscript.platform.content.mapper.AppContactProfileMapper">

	<!--
	  依据：云端 script_platform_dev 库 sys_contact_profile 表（附件5.1 表3-62）。
	  反推处理点：
	  1. has_contact 在 SQL 内计算，**不 select 三列密文**：本接口只判定「是否登记联系方式」，
	     避免加密串进入应用内存后被日志/序列化意外带出。
	  2. display_scope 原样下发；display_status/verify_status 按契约不下发，故不参与过滤。
	  3. owner_id 为唯一键，limit 1 兜底防止脏数据返回多行。
	-->
	<resultMap type="com.smartscript.platform.content.dto.AppContactDto" id="AppContactDtoResult">
		<result property="hasContact"   column="has_contact"   />
		<result property="displayScope" column="display_scope" />
		<result property="phone"        column="phone"         />
		<result property="email"        column="email"         />
		<result property="wechat"       column="wechat"        />
	</resultMap>

	<select id="selectContactByOwnerId" resultMap="AppContactDtoResult">
		select cp.display_scope,
		       case when coalesce(cp.phone_cipher, '') != ''
		              or coalesce(cp.email_cipher, '') != ''
		              or coalesce(cp.wechat_cipher, '') != ''
		            then 1 else 0 end as has_contact,
		       coalesce(nullif(cp.phone_cipher, ''), u.phonenumber) as phone,
		       cp.email_cipher  as email,
		       cp.wechat_cipher as wechat
		from sys_user u
		left join sys_contact_profile cp on cp.owner_id = u.user_id
		where u.user_id = #{ownerId}
		limit 1
	</select>

</mapper>