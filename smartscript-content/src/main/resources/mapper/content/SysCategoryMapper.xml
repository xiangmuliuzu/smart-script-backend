<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smartscript.platform.content.mapper.SysCategoryMapper">

	<!--
	  依据：云端 script_platform_dev 库 sys_category 表（13 字段）。
	  反推处理点：created_at/updated_at 不映射（DB 默认值维护）；
	  status tinyint ↔ String；category_id int ↔ Long。
	-->
	<resultMap type="SysCategory" id="SysCategoryResult">
		<id     property="categoryId"     column="category_id"     />
		<result property="categoryName"   column="category_name"   />
		<result property="categoryType"   column="category_type"   />
		<result property="parentId"       column="parent_id"       />
		<result property="sort"           column="sort"            />
		<result property="status"         column="status"          />
		<result property="createBy"       column="create_by"       />
		<result property="createTime"     column="create_time"     />
		<result property="updateBy"       column="update_by"       />
		<result property="updateTime"     column="update_time"     />
		<result property="remark"         column="remark"          />
	</resultMap>

	<sql id="selectCategoryVo">
		select category_id, category_name, category_type, parent_id, sort, status,
		       create_by, create_time, update_by, update_time, remark
		from sys_category
	</sql>

	<select id="selectCategoryList" parameterType="SysCategory" resultMap="SysCategoryResult">
		<include refid="selectCategoryVo"/>
		<where>
			<if test="categoryName != null and categoryName != ''">
				AND category_name like concat('%', #{categoryName}, '%')
			</if>
			<if test="categoryType != null and categoryType != ''">
				AND category_type = #{categoryType}
			</if>
			<if test="parentId != null">
				AND parent_id = #{parentId}
			</if>
			<if test="status != null and status != ''">
				AND status = #{status}
			</if>
		</where>
		order by sort, category_id
	</select>

	<select id="selectCategoryById" parameterType="Long" resultMap="SysCategoryResult">
		<include refid="selectCategoryVo"/>
		where category_id = #{categoryId}
	</select>

	<select id="checkCategoryNameUnique" parameterType="String" resultMap="SysCategoryResult">
		<include refid="selectCategoryVo"/>
		where category_name = #{categoryName} limit 1
	</select>

	<!--
	  新增：parent_id/sort/status 云端列 NOT NULL 无默认值（反推：由 Service 兜底默认 0/'0'），
	  此处直接写入。created_at/updated_at 由 DB 默认值维护，不写。
	-->
	<insert id="insertCategory" parameterType="SysCategory" useGeneratedKeys="true" keyProperty="categoryId">
		insert into sys_category(
			category_name, category_type, parent_id, sort, status,
			create_by, create_time, remark
		) values (
			#{categoryName}, #{categoryType}, #{parentId}, #{sort}, #{status},
			#{createBy}, sysdate(), #{remark}
		)
	</insert>

	<!-- 动态更新：仅更新非空字段；改状态/改排序复用本语句（单一职责在 Service 层拆分） -->
	<update id="updateCategory" parameterType="SysCategory">
		update sys_category
		<set>
			<if test="categoryName != null and categoryName != ''">category_name = #{categoryName},</if>
			<if test="categoryType != null and categoryType != ''">category_type = #{categoryType},</if>
			<if test="parentId != null">parent_id = #{parentId},</if>
			<if test="sort != null">sort = #{sort},</if>
			<if test="status != null and status != ''">status = #{status},</if>
			<if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
			<if test="remark != null">remark = #{remark},</if>
			update_time = sysdate()
		</set>
		where category_id = #{categoryId}
	</update>

	<!-- 物理删除分类 -->
	<delete id="deleteCategoryByIds" parameterType="Long">
		delete from sys_category where category_id in
		<foreach collection="array" item="categoryId" open="(" separator="," close=")">
			#{categoryId}
		</foreach>
	</delete>

	<!--
	  统计引用该分类的作品数（删除前校验）。
	  仅统计未删除作品（is_deleted = 0），与标签 use_count 的口径一致；
	  否则只被逻辑删除作品引用的分类将永远无法删除。
	-->
	<select id="countWorkByCategoryId" parameterType="Long" resultType="int">
		select count(1) from sys_work where genre_id = #{categoryId} and is_deleted = 0
	</select>

	<!-- 统计以该分类为父级的子分类数（删除前校验：有子分类不允许删除，避免 parent_id 悬空） -->
	<select id="countChildrenByParentId" resultType="int">
		select count(1) from sys_category where parent_id = #{categoryId}
	</select>

	<!-- 前移：当前分类从 oldSort 移到 newSort（newSort < oldSort），中间分类整体后移一位 -->
	<update id="shiftSortForward">
		update sys_category set sort = sort + 1
		where sort >= #{newSort} and sort &lt; #{oldSort}
		<if test="excludeId != null">and category_id != #{excludeId}</if>
	</update>

	<!-- 后移：当前分类从 oldSort 移到 newSort（newSort > oldSort），中间分类整体前移一位 -->
	<update id="shiftSortBackward">
		update sys_category set sort = sort - 1
		where sort > #{oldSort} and sort &lt;= #{newSort}
		<if test="excludeId != null">and category_id != #{excludeId}</if>
	</update>

	<!-- 当前最大位次（新增时以「最大位次 + 1」作为默认位次，追加到末尾） -->
	<select id="selectMaxSort" resultType="java.lang.Integer">
		select max(sort) from sys_category
	</select>

	<!-- 统计占用指定位次的其它分类数（位次唯一性强校验：结果 > 0 即重复，需回滚） -->
	<select id="countBySort" resultType="int">
		select count(1) from sys_category
		where sort = #{sort}
		<if test="excludeId != null">and category_id != #{excludeId}</if>
	</select>

	<!-- 删除后紧缩：把 sort 大于被删位次的其它分类整体前移一位，消除删除留下的位次空洞 -->
	<update id="shiftSortAfterDelete">
		update sys_category set sort = sort - 1
		where sort > #{deletedSort}
	</update>

	<!--
	  锁定位次写入作用域：对整表行加排他锁，串行化并发的位次维护事务。
	  位次是整表共享的槽位序列，并发下「判占用 → 腾位 → 写入」的中间结果彼此不可见，
	  两个事务都可能通过写入后唯一校验而落库重复位次；加锁后同一时刻只有一个位次事务在跑。
	  仅取锁语义，调用方忽略返回的 ID 列表。
	-->
	<select id="lockSortScope" resultType="java.lang.Long">
		select category_id from sys_category order by category_id for update
	</select>

</mapper>
