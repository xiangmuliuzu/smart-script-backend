# A0-R1 环境变量模板（复制为本机私有 .env.local，禁止提交真实值）

SERVER_PORT=8080

DB_URL=jdbc:mysql://localhost:3306/ruoyi_dev?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=GMT%2B8
DB_USERNAME=
DB_PASSWORD=

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=

# PC 管理员 Token 密钥（必填，>=32 字符，禁止弱口令/dev-only 占位）
# 缺失时应用拒绝启动
TOKEN_SECRET=
TOKEN_EXPIRE_MINUTES=30

DRUID_STAT_ENABLED=true
DRUID_LOGIN_USERNAME=
DRUID_LOGIN_PASSWORD=

# 验收脚本（禁止写入仓库）
# VERIFY_ADMIN_USER=admin
# VERIFY_ADMIN_PASSWORD=
# VERIFY_LIMITED_USER=g1viewer
# VERIFY_LIMITED_PASSWORD=
# VERIFY_BACKEND_BASE=http://127.0.0.1:8080
