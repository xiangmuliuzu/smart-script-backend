# 环境变量模板（复制为本机私有 .env.local，禁止提交真实值）
# 完整说明与「数据库初始化」流程见 README.md
# 数据库初始化不改用这些变量：初始化脚本读 DB_HOST/DB_PORT/DB_NAME/DB_USERNAME/DB_PASSWORD
# （见 README.md「环境变量」小节），这里的是运行期配置。

SERVER_PORT=8080

# ---------------------------------------------------------------- 数据库（运行期）
# 库名要与初始化脚本 -d/--database 的目标一致
DB_URL=jdbc:mysql://localhost:3306/smartscript_dev?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=GMT%2B8
DB_USERNAME=
DB_PASSWORD=

# ---------------------------------------------------------------- Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=

# ---------------------------------------------------------------- PC 管理员 Token
# 必填，>=32 字符，禁止弱口令/dev-only 占位；缺失时应用拒绝启动
TOKEN_SECRET=
TOKEN_EXPIRE_MINUTES=30

# ---------------------------------------------------------------- App 凭证域（A3 安全门禁）
# 全部必填；APP_TOKEN_SECRET 必须与 TOKEN_SECRET 不同且不是已知弱口令
APP_TOKEN_SECRET=
APP_TOKEN_ISSUER=
APP_TOKEN_AUDIENCE=
APP_REDIS_KEY_PREFIX=smartscript:dev:app-auth:
# local / test 才允许 SMS_PROVIDER=mock（非本地环境必须接真实短信通道）
APP_AUTH_ENV=local
SMS_PROVIDER=mock

# ---------------------------------------------------------------- A4 材料网关
# 必填，且不得位于 ruoyi.profile（D:/ruoyi/uploadPath）之下，否则材料会被公开
APP_ADMIN_MATERIAL_STORAGE_PATH=

# ---------------------------------------------------------------- Druid 监控台
DRUID_STAT_ENABLED=true
DRUID_LOGIN_USERNAME=
DRUID_LOGIN_PASSWORD=

# ---------------------------------------------------------------- 验收脚本（禁止写入仓库）
# VERIFY_ADMIN_USER=admin
# VERIFY_ADMIN_PASSWORD=
# VERIFY_LIMITED_USER=a1_operator
# VERIFY_LIMITED_PASSWORD=
# VERIFY_BACKEND_BASE=http://127.0.0.1:8080
