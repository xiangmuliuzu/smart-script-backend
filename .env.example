# 环境变量模板（复制为本机私有 .env.local，禁止提交真实值）
# 完整说明与「数据库初始化」流程见 README.md
# 数据库初始化不改用这些变量：初始化脚本读 DB_HOST/DB_PORT/DB_NAME/DB_USERNAME/DB_PASSWORD
# （见 README.md「环境变量」小节），这里的是运行期配置。

SERVER_PORT=8080

# ---------------------------------------------------------------- 数据库（运行期）
# 库名要与初始化脚本 -d/--database 的目标一致
DB_URL=jdbc:mysql://localhost:3306/smartscript_dev?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=GMT%2B8
DB_USERNAME=
DB_PASSWORD=

# ---------------------------------------------------------------- Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=

# ---------------------------------------------------------------- PC 管理员 Token
# 必填，>=32 字符，禁止弱口令/dev-only 占位；缺失时应用拒绝启动
TOKEN_SECRET=
TOKEN_EXPIRE_MINUTES=30

# ---------------------------------------------------------------- App 凭证域（A3 安全门禁）
# App 登录复用上方 TOKEN_SECRET；以下为短信和协议配置
APP_REDIS_KEY_PREFIX=smartscript:dev:app-auth:
# local / test 才允许 SMS_PROVIDER=mock（非本地环境必须接真实短信通道）
APP_AUTH_ENV=local
SMS_PROVIDER=mock
# 联调提示：mock 短信验证码无内置默认值，本地联调时可设置固定值方便 App 端验证：
# APP_SMS_MOCK_CODE=123456（也可临时把 application.yml 中 app.sms.mock-fixed-code
# 的默认值改为 123456，但该改动请勿提交）。
# APP_SMS_MOCK_CODE=

# ---------------------------------------------------------------- 阿里云实名认证（云市场 cmapi025518）
# HTTPS AppCode 鉴权；密钥仅放 .env.local。启用后每次有效提交调用一次，不自动重试。
ALIYUN_REAL_NAME_ENABLED=false
ALIYUN_REAL_NAME_APPCODE=
# 可选：留空走云市场正式地址；联调时可指向本地 stub（如 http://127.0.0.1:18080/idenAuthentication），
# 这样整条链路可回归而不消耗试用次数。
# ALIYUN_REAL_NAME_ENDPOINT=

# ---------------------------------------------------------------- A4 材料网关
# 默认在后端仓库根目录；不得位于公开的 ruoyi.profile 上传目录之下
APP_ADMIN_MATERIAL_STORAGE_PATH=private-materials

# ---------------------------------------------------------------- Druid 监控台
DRUID_STAT_ENABLED=true
DRUID_LOGIN_USERNAME=
DRUID_LOGIN_PASSWORD=

# ---------------------------------------------------------------- AI 创作（直连大模型）
# 大模型基址（OpenAI 兼容，默认 DeepSeek）
AI_BASE_URL=https://api.deepseek.com
# 接口密钥（必填；仅写入本机 .env.local，禁止提交真实值）
AI_API_KEY=
# 模型名（DeepSeek：deepseek-flash / deepseek-v4-pro）
AI_SERVICE_MODEL=deepseek-flash
AI_SERVICE_PROVIDER=deepseek

# ---------------------------------------------------------------- 验收脚本（禁止写入仓库）
# VERIFY_ADMIN_USER=admin
# VERIFY_ADMIN_PASSWORD=
# VERIFY_LIMITED_USER=a1_operator
# VERIFY_LIMITED_PASSWORD=
# VERIFY_BACKEND_BASE=http://127.0.0.1:8080
